{
  "$description": "Excellence Swimming design tokens (W3C Design Tokens format). Import into Figma Variables with a DTCG-compatible importer (e.g. Tokens Studio or 'Variables Import'). Collections: Color, Typography, Spacing, Radius, Layout.",
  "Color": {
    "Primary": {
      "Navy": { "$type": "color", "$value": "#071A26" }
    },
    "Secondary": {
      "Ocean": { "$type": "color", "$value": "#123A4D" }
    },
    "Background": {
      "Cream": { "$type": "color", "$value": "#F5F3EE" },
      "Neutral": { "$type": "color", "$value": "#EAE7DF" },
      "White": { "$type": "color", "$value": "#FFFFFF" }
    },
    "Accent": {
      "Aqua": { "$type": "color", "$value": "#7FB7B3", "$description": "Text use on dark backgrounds only (7.6:1 on Navy). Decorative only on light." },
      "Warm": { "$type": "color", "$value": "#C5B89F", "$description": "Decorative accent. Not for text." }
    },
    "Text": {
      "Primary": { "$type": "color", "$value": "#111820" },
      "Light": { "$type": "color", "$value": "#FFFFFF" },
      "Muted": { "$type": "color", "$value": "#4A5560", "$description": "6.9:1 on Cream" },
      "Muted Light": { "$type": "color", "$value": "#FFFFFFB8", "$description": "White 72% — 9:1 on Navy" }
    },
    "Line": {
      "Default": { "$type": "color", "$value": "#11182029", "$description": "Text/Primary 16%" },
      "Strong": { "$type": "color", "$value": "#11182052", "$description": "Text/Primary 32%" },
      "On Dark": { "$type": "color", "$value": "#FFFFFF33", "$description": "White 20%" }
    },
    "Overlay": {
      "Navy 78": { "$type": "color", "$value": "#071A26C7" },
      "Hero Top": { "$type": "color", "$value": "#071A2673", "$description": "45% — top of hero gradient" },
      "Hero Bottom": { "$type": "color", "$value": "#071A26D9", "$description": "85% — bottom of hero gradient" }
    }
  },
  "Typography": {
    "Display / Hero": {
      "$type": "typography",
      "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "84px", "lineHeight": "98%", "letterSpacing": "-3%", "textCase": "uppercase" },
      "$description": "Tablet 64px · Mobile 44px"
    },
    "Heading / H1": {
      "$type": "typography",
      "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "80px", "lineHeight": "98%", "letterSpacing": "-3%", "textCase": "uppercase" },
      "$description": "Tablet 60px · Mobile 44px"
    },
    "Heading / H2": {
      "$type": "typography",
      "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "56px", "lineHeight": "102%", "letterSpacing": "-2.5%", "textCase": "uppercase" },
      "$description": "Tablet 44px · Mobile 34px"
    },
    "Heading / H3": {
      "$type": "typography",
      "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "32px", "lineHeight": "110%", "letterSpacing": "-1.5%", "textCase": "uppercase" },
      "$description": "Tablet 28px · Mobile 22px"
    },
    "Body / Large": {
      "$type": "typography",
      "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "18px", "lineHeight": "160%", "letterSpacing": "0%" },
      "$description": "Mobile 17px. Max width ~46ch (≈ 480px)."
    },
    "Body / Standard": {
      "$type": "typography",
      "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "16px", "lineHeight": "165%", "letterSpacing": "0.5%" },
      "$description": "All breakpoints. Max width ~48ch (≈ 440px)."
    },
    "Body / Small": {
      "$type": "typography",
      "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "15px", "lineHeight": "160%", "letterSpacing": "0%" }
    },
    "Label": {
      "$type": "typography",
      "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "13px", "lineHeight": "120%", "letterSpacing": "16%", "textCase": "uppercase" }
    },
    "Navigation": {
      "$type": "typography",
      "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "14px", "lineHeight": "100%", "letterSpacing": "1%" }
    },
    "Button": {
      "$type": "typography",
      "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "14px", "lineHeight": "100%", "letterSpacing": "8%", "textCase": "uppercase" }
    }
  },
  "Spacing": {
    "8": { "$type": "dimension", "$value": "8px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "24": { "$type": "dimension", "$value": "24px" },
    "32": { "$type": "dimension", "$value": "32px" },
    "40": { "$type": "dimension", "$value": "40px" },
    "48": { "$type": "dimension", "$value": "48px" },
    "64": { "$type": "dimension", "$value": "64px" },
    "80": { "$type": "dimension", "$value": "80px" },
    "96": { "$type": "dimension", "$value": "96px" },
    "120": { "$type": "dimension", "$value": "120px" },
    "160": { "$type": "dimension", "$value": "160px" }
  },
  "Radius": {
    "Small": { "$type": "dimension", "$value": "4px", "$description": "Buttons, chips, inputs" },
    "Medium": { "$type": "dimension", "$value": "8px", "$description": "Reserved" },
    "Large": { "$type": "dimension", "$value": "12px", "$description": "Reserved — never on photography" }
  },
  "Layout": {
    "Desktop": {
      "Frame Width": { "$type": "dimension", "$value": "1280px" },
      "Margin": { "$type": "dimension", "$value": "64px" },
      "Columns": { "$type": "number", "$value": 12 },
      "Gutter": { "$type": "dimension", "$value": "24px" },
      "Section Padding": { "$type": "dimension", "$value": "144px", "$description": "Range 100–160" },
      "Header Height": { "$type": "dimension", "$value": "84px" }
    },
    "Tablet": {
      "Frame Width": { "$type": "dimension", "$value": "768px" },
      "Margin": { "$type": "dimension", "$value": "40px" },
      "Columns": { "$type": "number", "$value": 8 },
      "Gutter": { "$type": "dimension", "$value": "20px" },
      "Section Padding": { "$type": "dimension", "$value": "96px", "$description": "Range 80–110" },
      "Header Height": { "$type": "dimension", "$value": "76px" }
    },
    "Mobile": {
      "Frame Width": { "$type": "dimension", "$value": "390px" },
      "Margin": { "$type": "dimension", "$value": "20px" },
      "Columns": { "$type": "number", "$value": 4 },
      "Gutter": { "$type": "dimension", "$value": "16px" },
      "Section Padding": { "$type": "dimension", "$value": "72px", "$description": "Range 60–80" },
      "Header Height": { "$type": "dimension", "$value": "68px" }
    }
  }
}
