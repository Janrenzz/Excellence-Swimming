{
  "$description": "Excellence Swimming design tokens v2 (W3C Design Tokens format). Import into Figma Variables (Tokens Studio or a DTCG importer) and mirror in Wix Studio Site Styles. Three brand colours only: Ink Navy, Warm White, Champagne Gold.",
  "Color": {
    "Brand": {
      "Ink Navy": { "$type": "color", "$value": "#0E1B2C", "$description": "Text, navigation, footer, primary buttons" },
      "Warm White": { "$type": "color", "$value": "#FAF8F4", "$description": "Page background" },
      "Champagne Gold": { "$type": "color", "$value": "#C6A969", "$description": "Thin rules, chips, credential bar, labels on Ink. Never large fills or big buttons." }
    },
    "Derived": {
      "Gold Ink": { "$type": "color", "$value": "#876628", "$description": "Gold for small text on Warm White (4.8:1)" },
      "Ink Muted": { "$type": "color", "$value": "#0E1B2CB8", "$description": "Ink 72% — body copy (6.8:1 on Warm White)" },
      "Ink Line": { "$type": "color", "$value": "#0E1B2C24", "$description": "Ink 14% — hairlines" },
      "Ink Line Strong": { "$type": "color", "$value": "#0E1B2C47", "$description": "Ink 28% — section rules" },
      "Ink Wash": { "$type": "color", "$value": "#0E1B2C0A", "$description": "Ink 4% — quiet panels (forms, booking summary)" },
      "Paper Muted": { "$type": "color", "$value": "#FAF8F4BD", "$description": "Warm White 74% — body copy on Ink" },
      "Paper Line": { "$type": "color", "$value": "#FAF8F42E", "$description": "Warm White 18% — hairlines on Ink" },
      "Error": { "$type": "color", "$value": "#8E2B20", "$description": "Form errors only, always with a text message" }
    }
  },
  "Typography": {
    "Display": { "$type": "typography", "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "88px", "lineHeight": "96%", "letterSpacing": "-3%", "textCase": "uppercase" }, "$description": "Tablet 64 · Mobile 44" },
    "H1": { "$type": "typography", "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "72px", "lineHeight": "98%", "letterSpacing": "-3%", "textCase": "uppercase" }, "$description": "Tablet 56 · Mobile 40" },
    "H2": { "$type": "typography", "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "52px", "lineHeight": "102%", "letterSpacing": "-2.5%", "textCase": "uppercase" }, "$description": "Tablet 42 · Mobile 32" },
    "H3": { "$type": "typography", "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "28px", "lineHeight": "112%", "letterSpacing": "-1.5%", "textCase": "uppercase" }, "$description": "Tablet 24 · Mobile 20" },
    "Body Large": { "$type": "typography", "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "19px", "lineHeight": "160%", "letterSpacing": "0%" }, "$description": "Mobile 17 · max width ~48ch" },
    "Body": { "$type": "typography", "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "16px", "lineHeight": "165%", "letterSpacing": "0.5%" }, "$description": "Max width ~52ch" },
    "Small": { "$type": "typography", "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "14px", "lineHeight": "155%", "letterSpacing": "0%" } },
    "Label": { "$type": "typography", "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "12px", "lineHeight": "120%", "letterSpacing": "18%", "textCase": "uppercase" } },
    "Credential": { "$type": "typography", "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "11px", "lineHeight": "120%", "letterSpacing": "12%", "textCase": "uppercase" } },
    "Navigation": { "$type": "typography", "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "14px", "lineHeight": "100%", "letterSpacing": "0.5%" } },
    "Button": { "$type": "typography", "$value": { "fontFamily": "Sora", "fontWeight": 800, "fontSize": "14px", "lineHeight": "100%", "letterSpacing": "10%", "textCase": "uppercase" } }
  },
  "Spacing": {
    "8": { "$type": "dimension", "$value": "8px" }, "16": { "$type": "dimension", "$value": "16px" }, "24": { "$type": "dimension", "$value": "24px" },
    "32": { "$type": "dimension", "$value": "32px" }, "40": { "$type": "dimension", "$value": "40px" }, "48": { "$type": "dimension", "$value": "48px" },
    "64": { "$type": "dimension", "$value": "64px" }, "80": { "$type": "dimension", "$value": "80px" }, "96": { "$type": "dimension", "$value": "96px" },
    "120": { "$type": "dimension", "$value": "120px" }, "160": { "$type": "dimension", "$value": "160px" }
  },
  "Radius": {
    "Small": { "$type": "dimension", "$value": "4px", "$description": "Buttons, inputs, slots" },
    "Pill": { "$type": "dimension", "$value": "999px", "$description": "Credential chips only" }
  },
  "Layout": {
    "Desktop": { "Frame Width": { "$type": "dimension", "$value": "1280px" }, "Margin": { "$type": "dimension", "$value": "64px" }, "Columns": { "$type": "number", "$value": 12 }, "Gutter": { "$type": "dimension", "$value": "24px" }, "Section Padding": { "$type": "dimension", "$value": "136px" }, "Header Height": { "$type": "dimension", "$value": "80px" } },
    "Tablet": { "Frame Width": { "$type": "dimension", "$value": "768px" }, "Margin": { "$type": "dimension", "$value": "40px" }, "Columns": { "$type": "number", "$value": 8 }, "Gutter": { "$type": "dimension", "$value": "20px" }, "Section Padding": { "$type": "dimension", "$value": "96px" }, "Header Height": { "$type": "dimension", "$value": "72px" } },
    "Mobile": { "Frame Width": { "$type": "dimension", "$value": "390px" }, "Margin": { "$type": "dimension", "$value": "20px" }, "Columns": { "$type": "number", "$value": 4 }, "Gutter": { "$type": "dimension", "$value": "16px" }, "Section Padding": { "$type": "dimension", "$value": "72px" }, "Header Height": { "$type": "dimension", "$value": "64px" } }
  }
}
